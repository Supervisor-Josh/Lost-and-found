# Campus Finds - Environment Variables Template
# Copy this file to .env for local development or configure these in your deployment platform.

# Authentication Secret (Required in production: minimum 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
LOST_FOUND_AUTH_SECRET=your-32-plus-character-secret-key-goes-here

# Admin Key for moderating items and claims
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LOST_FOUND_ADMIN_KEY=your-secure-admin-key-here

# CORS Origins (Comma-separated list of frontend URLs)
LOST_FOUND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection (Optional: defaults to local SQLite file if not set)
# Example for PostgreSQL: postgresql://username:password@hostname:5432/lost_and_found_db
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# App Environment (development or production)
ENVIRONMENT=development

# Toggle API Docs (/docs and /redoc). Set to false in production if you want docs hidden.
ENABLE_DOCS=true
